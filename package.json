  "description": "Public backend samples and design notes for Fateflow, a rule-based saju reading service without LLM API calls.",
  "private": false,
  "type": "module",
  "scripts": {
    "check": "npm run check:secrets && npm run check:structure",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "list:samples": "node scripts/list-samples.mjs"
